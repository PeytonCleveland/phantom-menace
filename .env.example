# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgres://lighthouse:lighthouse@localhost:5432/lighthouse

# ── Better Auth ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# ── Email domain allowlist ────────────────────────────────────────────────────
# Comma-separated. Omit to use the built-in default (teambespin.us).
# Exact-match only: subdomains are NOT admitted.
# AUTH_ALLOWED_EMAIL_DOMAINS=teambespin.us

# ── OTP email delivery (AWS SES) ──────────────────────────────────────────────
# When AUTH_EMAIL_FROM and AWS_REGION are both set, SES is used. Otherwise the
# console sender prints codes to stdout (non-production only).
# Credentials come from the ambient AWS chain (env vars, profile, or IAM role).
# AUTH_EMAIL_FROM="Lighthouse <no-reply@teambespin.us>"
# AWS_REGION=us-east-1
# AUTH_SES_CONFIGURATION_SET=

# ── Passkeys (WebAuthn) ───────────────────────────────────────────────────────
# rpID is the registrable domain, with no scheme or port. Origin must include
# the scheme and port and must NOT have a trailing slash.
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=Lighthouse
PASSKEY_ORIGIN=http://localhost:3000
